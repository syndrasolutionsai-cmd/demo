    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $input.item.json;\nconst prompt = \"Eres consultor de marketing digital senior en Espana. Analiza esta empresa: Nombre: \" + n.nombre + \". Sector: \" + n.sector + \". Ciudad: \" + n.ciudad + \". Valoracion Google: \" + n.valoracion + \" estrellas con \" + n.num_reseñas + \" resenas. Web: \" + n.url_web + \". Responde SOLO con JSON sin markdown: {\\\"problema_1\\\":\\\"...\\\",\\\"problema_2\\\":\\\"...\\\",\\\"problema_3\\\":\\\"...\\\",\\\"coste_mensual_estimado\\\":\\\"...\\\",\\\"accion_1\\\":\\\"...\\\",\\\"accion_2\\\":\\\"...\\\",\\\"accion_3\\\":\\\"...\\\",\\\"oportunidad\\\":\\\"...\\\",\\\"resumen_ejecutivo\\\":\\\"...\\\"}\";\nconst promptLimpio = prompt.replace(/[\\u0000-\\u001F\\u007F]/g,' ').replace(/\\s+/g,' ').trim();\nreturn { json: { nombre: n.nombre, sector: n.sector, ciudad: n.ciudad, telefono: n.telefono || \"\", valoracion: n.valoracion, num_reseñas: n.num_reseñas, url_web: n.url_web, prompt: promptLimpio } };"
      },
