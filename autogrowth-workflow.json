    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resultados = items[0].json.resultados || [];\nconst fecha = new Date().toLocaleDateString('es-ES', {weekday:'long', day:'numeric', month:'long'});\nlet texto = \"*AutoGrowth — \" + fecha + \"*\\n\\n\";\ntexto += \"📊 *Resumen semanal*\\n\";\ntexto += \"━━━━━━━━━━━━━━━\\n\";\ntexto += \"🏢 Negocios analizados: \" + resultados.length + \"\\n\";\ntexto += \"📧 Emails generados: \" + resultados.length + \"\\n\";\ntexto += \"💾 Guardados en Sheets: \" + resultados.length + \"\\n\\n\";\ntexto += \"*Top diagnosticos esta semana:*\\n\\n\";\nresultados.slice(0,3).forEach((r,i) => {\n  texto += (i+1) + \". *\" + (r.nombre||\"\") + \"* — \" + (r.ciudad||\"\") + \"\\n\";\n  texto += \"   💸 \" + (r.diagnostico&&r.diagnostico.coste_mensual_estimado||\"\") + \"\\n\\n\";\n});\ntexto += \"━━━━━━━━━━━━━━━\\n\";\ntexto += \"Ver todos los diagnosticos en Google Sheets\";\nreturn [{ json: { mensaje_telegram: texto } }];"
      },
