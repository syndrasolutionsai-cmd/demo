    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $input.item.json;\nlet content = \"\";\nif (input.content && Array.isArray(input.content)) {\n  content = input.content[0].text || \"\";\n}\nlet emailData;\ntry {\n  content = content.replace(/```json/gi,\"\").replace(/```/g,\"\").trim();\n  const m = content.match(/\\{[\\s\\S]*\\}/);\n  if (m) { emailData = JSON.parse(m[0]); } else { throw new Error(\"no json\"); }\n} catch(e) {\n  emailData = { asunto: \"Diagnostico para \" + (input.nombre||\"\"), cuerpo: \"Error al generar email\" };\n}\nreturn { json: { nombre: input.nombre||\"\", sector: input.sector||\"\", ciudad: input.ciudad||\"\", telefono: input.telefono||\"\", url_web: input.url_web||\"\", valoracion: input.valoracion||null, num_reseñas: input.num_reseñas||null, diagnostico: input.diagnostico||{}, email_asunto: emailData.asunto||\"\", email_cuerpo: emailData.cuerpo||\"\" } };"
      },
