      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "Merge Diagnostico",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $input.item.json;\nconst nombre = input.nombre || \"\";\nconst sector = input.sector || \"\";\nconst ciudad = input.ciudad || \"\";\nconst telefono = input.telefono || \"\";\nconst valoracion = input.valoracion || null;\nconst num_reseñas = input.num_reseñas || null;\nconst url_web = input.url_web || \"\";\nlet content = \"\";\nif (input.content && Array.isArray(input.content)) {\n  content = input.content[0].text || \"\";\n}\nlet diagnostico;\ntry {\n  content = content.replace(/```json/gi,\"\").replace(/```/g,\"\").trim();\n  const m = content.match(/\\{[\\s\\S]*\\}/);\n  if (m) { diagnostico = JSON.parse(m[0]); } else { throw new Error(\"no json\"); }\n} catch(e) {\n  diagnostico = { problema_1:\"\", problema_2:\"\", problema_3:\"\", coste_mensual_estimado:\"\", accion_1:\"\", accion_2:\"\", accion_3:\"\", oportunidad:\"\", resumen_ejecutivo:\"\" };\n}\n[\"problema_1\",\"problema_2\",\"problema_3\",\"coste_mensual_estimado\",\"accion_1\",\"accion_2\",\"accion_3\",\"oportunidad\",\"resumen_ejecutivo\"].forEach(k=>{ if(!diagnostico[k]) diagnostico[k]=\"\"; });\nreturn { json: { nombre, sector, ciudad, telefono, valoracion, num_reseñas, url_web, diagnostico } };"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "Parsea Diagnostico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\nconst diag = d.diagnostico || {};\nconst prompt = \"Eres director de Impulsa Agency en Espana. Escribe email frio para responsable de esta empresa. Empresa: \" + d.nombre + \". Sector: \" + d.sector + \". Ciudad: \" + d.ciudad + \". Problema principal: \" + (diag.problema_1||\"\") + \". Coste estimado: \" + (diag.coste_mensual_estimado||\"\") + \". El email: maximo 5 lineas, especifico, genera curiosidad sobre diagnostico privado, CTA para ver diagnostico en enlace, sin frases corporativas. Responde SOLO con JSON sin markdown: {\\\"asunto\\\":\\\"...\\\",\\\"cuerpo\\\":\\\"...\\\"}\";\nconst promptLimpio = prompt.replace(/[\\u0000-\\u001F\\u007F]/g,' ').replace(/\\s+/g,' ').trim();\nreturn { json: { nombre: d.nombre, sector: d.sector, ciudad: d.ciudad, telefono: d.telefono||\"\", url_web: d.url_web||\"\", valoracion: d.valoracion||null, num_reseñas: d.num_reseñas||null, diagnostico: d.diagnostico, prompt_email: promptLimpio } };"
      },
