            {
              "id": "html_report",
              "name": "html_reporte",
              "value": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reporte Semanal — Clínica Dental Sonrisas</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'Inter', Arial, sans-serif; background: #f9fafb; color: #1f2937; }\n    .wrapper { max-width: 680px; margin: 0 auto; background: #ffffff; }\n    /* HEADER */\n    .header { background: #1a73e8; padding: 36px 40px; }\n    .header-logo { font-size: 22px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; }\n    .header-logo span { color: #93c5fd; }\n    .header-subtitle { font-size: 13px; color: #bfdbfe; margin-top: 4px; font-weight: 500; }\n    .header-client { margin-top: 20px; }\n    .header-client-name { font-size: 26px; font-weight: 700; color: #ffffff; }\n    .header-client-date { font-size: 14px; color: #bfdbfe; margin-top: 4px; }\n    .header-badge { display: inline-block; background: rgba(255,255,255,0.2); color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; margin-top: 10px; }\n    /* SECTION */\n    .section { padding: 32px 40px; }\n    .section-title { font-size: 13px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; }\n    /* METRICS CARDS */\n    .cards-grid { display: flex; gap: 16px; }\n    .card { flex: 1; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }\n    .card-header { padding: 14px 20px; font-size: 13px; font-weight: 700; color: #ffffff; }\n    .card-header.google { background: #1a73e8; }\n    .card-header.meta { background: #1877f2; }\n    .card-body { padding: 20px; }\n    .metric-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f3f4f6; }\n    .metric-row:last-child { border-bottom: none; }\n    .metric-label { font-size: 13px; color: #6b7280; }\n    .metric-value { font-size: 15px; font-weight: 700; color: #1f2937; }\n    .badge { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; margin-left: 8px; }\n    .badge.up { background: #d1fae5; color: #065f46; }\n    .badge.down { background: #fee2e2; color: #991b1b; }\n    /* PROGRESS BAR */\n    .progress-section { background: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 24px; }\n    .progress-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n    .progress-title { font-size: 14px; font-weight: 700; color: #1f2937; }\n    .progress-numbers { font-size: 14px; font-weight: 600; color: #1a73e8; }\n    .progress-bar-bg { background: #dbeafe; border-radius: 99px; height: 12px; overflow: hidden; }\n    .progress-bar-fill { background: linear-gradient(90deg, #1a73e8, #3b82f6); height: 100%; border-radius: 99px; width: 51%; }\n    .progress-footer { display: flex; justify-content: space-between; margin-top: 8px; font-size: 12px; color: #6b7280; }\n    /* SUMMARY */\n    .summary-box { background: #f9fafb; border-left: 4px solid #1a73e8; border-radius: 0 8px 8px 0; padding: 24px; white-space: pre-wrap; font-size: 14px; line-height: 1.8; color: #374151; }\n    /* DIVIDER */\n    .divider { height: 1px; background: #e5e7eb; margin: 0 40px; }\n    /* FOOTER */\n    .footer { background: #1f2937; padding: 28px 40px; }\n    .footer-agency { font-size: 16px; font-weight: 700; color: #ffffff; }\n    .footer-info { font-size: 13px; color: #9ca3af; margin-top: 8px; line-height: 1.8; }\n    .footer-disclaimer { font-size: 11px; color: #6b7280; margin-top: 16px; border-top: 1px solid #374151; padding-top: 16px; }\n  </style>\n</head>\n<body>\n  <div class=\"wrapper\">\n\n    <!-- HEADER -->\n    <div class=\"header\">\n      <div class=\"header-logo\">MOMENTUM<span>DIGITAL</span></div>\n      <div class=\"header-subtitle\">Agencia de Performance Marketing · Madrid</div>\n      <div class=\"header-client\">\n        <div class=\"header-client-name\">Clínica Dental Sonrisas</div>\n        <div class=\"header-client-date\">Reporte Semanal · Semana del 10 al 16 de Marzo, 2025</div>\n        <div class=\"header-badge\">📊 Informe Automático Semanal</div>\n      </div>\n    </div>\n\n    <!-- METRICS -->\n    <div class=\"section\">\n      <div class=\"section-title\">Rendimiento de Campañas</div>\n      <div class=\"cards-grid\">\n\n        <!-- GOOGLE ADS -->\n        <div class=\"card\">\n          <div class=\"card-header google\">🔵 Google Ads</div>\n          <div class=\"card-body\">\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Inversión</span>\n              <span class=\"metric-value\">1.247€ <span class=\"badge up\">▲ 5.7%</span></span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Pacientes captados</span>\n              <span class=\"metric-value\">23 <span class=\"badge up\">▲ 21%</span></span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Coste por paciente</span>\n              <span class=\"metric-value\">54,20€</span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Clicks totales</span>\n              <span class=\"metric-value\">1.891</span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Impresiones</span>\n              <span class=\"metric-value\">48.320</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- META ADS -->\n        <div class=\"card\">\n          <div class=\"card-header meta\">🔷 Meta Ads</div>\n          <div class=\"card-body\">\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Inversión</span>\n              <span class=\"metric-value\">830€ <span class=\"badge up\">▲ 5.1%</span></span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Solicitudes de cita</span>\n              <span class=\"metric-value\">18 <span class=\"badge up\">▲ 28.6%</span></span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Coste por solicitud</span>\n              <span class=\"metric-value\">46,10€</span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Clicks totales</span>\n              <span class=\"metric-value\">743</span>\n            </div>\n            <div class=\"metric-row\">\n              <span class=\"metric-label\">Personas alcanzadas</span>\n              <span class=\"metric-value\">31.200</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"divider\"></div>\n\n    <!-- PROGRESS -->\n    <div class=\"section\">\n      <div class=\"section-title\">Objetivo del Mes</div>\n      <div class=\"progress-section\">\n        <div class=\"progress-header\">\n          <div class=\"progress-title\">🎯 Meta: 80 pacientes nuevos en marzo</div>\n          <div class=\"progress-numbers\">41 / 80</div>\n        </div>\n        <div class=\"progress-bar-bg\">\n          <div class=\"progress-bar-fill\"></div>\n        </div>\n        <div class=\"progress-footer\">\n          <span>51% del objetivo conseguido</span>\n          <span>✅ Ritmo correcto (51% del mes transcurrido)</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"divider\"></div>\n\n    <!-- CLAUDE SUMMARY -->\n    <div class=\"section\">\n      <div class=\"section-title\">Análisis de tu Account Manager</div>\n      <div class=\"summary-box\">{{ $('🤖 Claude AI — Genera Resumen').item.json.content[0].text }}</div>\n    </div>\n\n    <div class=\"divider\"></div>\n\n    <!-- FOOTER -->\n    <div class=\"footer\">\n      <div class=\"footer-agency\">Momentum Digital</div>\n      <div class=\"footer-info\">\n        📍 Calle Gran Vía 45, 3ª planta · 28013 Madrid<br>\n        📧 hola@momentumdigital.es · 📞 +34 91 234 56 78<br>\n        🌐 www.momentumdigital.es\n      </div>\n      <div class=\"footer-disclaimer\">\n        Este reporte ha sido generado automáticamente por AutoReport, el sistema de informes de Momentum Digital. \n        Los datos proceden directamente de las plataformas publicitarias y se actualizan cada lunes a las 08:00h.\n        Para cualquier consulta, contacta con tu account manager en hola@momentumdigital.es\n      </div>\n    </div>\n\n  </div>\n</body>\n</html>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
